<Application x:Class="MVTC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Themeable brushes - swapped at runtime by MVTC.App.Services.ThemeService.
             Defaults match the "Mesh" theme (cohesive with the login hero). -->
        <SolidColorBrush x:Key="TitleBarBrush"        Color="#1A1826"/>
        <SolidColorBrush x:Key="TitleAccentBrush"     Color="#3B2F55"/>
        <SolidColorBrush x:Key="TitleFgBrush"         Color="#F0E6F5"/>
        <SolidColorBrush x:Key="TitleBadgeBgBrush"    Color="#1F2E2A"/>
        <SolidColorBrush x:Key="TitleBadgeFgBrush"    Color="#50FA7B"/>
        <SolidColorBrush x:Key="SubHeaderBgBrush"     Color="#14121D"/>
        <SolidColorBrush x:Key="SubHeaderBorderBrush" Color="#2A2435"/>
        <SolidColorBrush x:Key="BrandBgBrush"         Color="#FF4F8B"/>
        <SolidColorBrush x:Key="BrandFgBrush"         Color="#2A0C1A"/>
        <SolidColorBrush x:Key="SidebarBgBrush"       Color="#0F0E16"/>
        <SolidColorBrush x:Key="SidebarBorderBrush"   Color="#2A2435"/>
        <SolidColorBrush x:Key="SidebarActiveBrush"   Color="#261B38"/>
        <SolidColorBrush x:Key="SidebarFgBrush"       Color="#B8B3C7"/>
        <SolidColorBrush x:Key="SidebarActiveFgBrush" Color="#FFBED6"/>
        <SolidColorBrush x:Key="AppBgBrush"           Color="#14121D"/>
        <SolidColorBrush x:Key="OuterBorderBrush"     Color="#2A2435"/>
        <SolidColorBrush x:Key="CardBgBrush"          Color="#1C1A27"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#2A2435"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#F0E6F5"/>
        <SolidColorBrush x:Key="TextMutedBrush"       Color="#A098B4"/>
        <SolidColorBrush x:Key="TextAccentBrush"      Color="#8BE9FD"/>
        <SolidColorBrush x:Key="FooterBgBrush"        Color="#0F0E16"/>
        <SolidColorBrush x:Key="FooterFgBrush"        Color="#A098B4"/>

        <!-- Global dark-theme styles so every DataGrid picks up visible headers,
             rows and cells without each panel having to redeclare them. -->

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background"      Value="#111827"/>
            <Setter Property="Foreground"      Value="#79B8FF"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="BorderBrush"     Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorBrush"  Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2436"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background"      Value="#0A0F17"/>
            <Setter Property="Foreground"      Value="#E6EDF3"/>
            <Setter Property="BorderBrush"     Value="#161B22"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#13202E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F3B5C"/>
                    <Setter Property="Foreground" Value="#E6EDF3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground"      Value="#E6EDF3"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E6EDF3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row-select "left margin" indicator strip in the DataGridRowHeader column
             uses this; keep it dark so the gridstill reads as flat. -->
        <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Background"      Value="#0A0F17"/>
            <Setter Property="BorderBrush"     Value="#161B22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="0"/>
        </Style>
    </Application.Resources>
</Application>
