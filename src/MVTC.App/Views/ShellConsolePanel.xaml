<UserControl x:Class="MVTC.App.Views.ShellConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#02040A" Foreground="#C9D1D9"
             FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#06090F" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="#141A24" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Shell console" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Opacity="0.65" Margin="0,4,0,0"
                           Text="In-app terminal. Runs anything 'cmd /c' accepts. Output and exit code shown below. No external terminal required."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#06090F" CornerRadius="6" Padding="12" Margin="0,10,0,0" BorderBrush="#141A24" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="mvtc@vault:~$ " FontFamily="Consolas" FontSize="13" Foreground="#3FB950" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="1" x:Name="CommandBox"
                               Background="#0A0E14" Foreground="#C9D1D9" BorderBrush="#1F2937" BorderThickness="1" Padding="8"
                               FontFamily="Consolas" FontSize="13"
                               KeyDown="OnCommandKey"/>
                    <Button    Grid.Column="2" x:Name="RunButton" Content="Run" Margin="8,0,0,0" Click="OnRun"
                               Background="#1F6FEB" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="13" MinWidth="90"/>
                </Grid>
                <TextBlock x:Name="BusyText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" Foreground="#F0883E" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Background="#06090F" CornerRadius="6" BorderBrush="#141A24" BorderThickness="1">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputBox"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         Background="Transparent" Foreground="#C9D1D9" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="14"
                         Text="mvtc shell ready. Try: whoami  |  ipconfig  |  dir %APPDATA%\MVTC"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
