<UserControl x:Class="MVTC.App.Views.NetworkCapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070A0F" Foreground="#E6EDF3"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0F17"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#161B22"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#161B22"/>
            <Setter Property="RowBackground" Value="#0A0F17"/>
            <Setter Property="AlternatingRowBackground" Value="#101620"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Network capture" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Opacity="0.65" Margin="0,4,0,10"
                           Text="Every HTTP call MVTC makes to its backend / update server is recorded here with method, URL, status, body and timing. Use this when you don't want to stand up Burp or Wireshark."/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh"       Click="OnRefresh"/>
                    <Button Content="Clear"         Margin="8,0,0,0" Background="#30363D" Click="OnClear"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Entries" Grid.Column="0" SelectionChanged="OnEntrySelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"       Binding="{Binding TimeDisplay}"  Width="80"/>
                    <DataGridTextColumn Header="Method"     Binding="{Binding Method}"       Width="60"/>
                    <DataGridTextColumn Header="Status"     Binding="{Binding StatusCode}"   Width="60"/>
                    <DataGridTextColumn Header="URL"        Binding="{Binding Url}"          Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="#0A0F17" BorderBrush="#161B22" BorderThickness="1" Margin="12,0,0,0" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="DetailHeader" Text="Select a request to see the body." FontSize="12" Opacity="0.65"/>
                        <TextBlock Text="REQUEST BODY" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,14,0,4"/>
                        <TextBox x:Name="RequestBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8" MinHeight="120"/>
                        <TextBlock Text="RESPONSE BODY" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,14,0,4"/>
                        <TextBox x:Name="ResponseBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D" Padding="8" MinHeight="200"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
