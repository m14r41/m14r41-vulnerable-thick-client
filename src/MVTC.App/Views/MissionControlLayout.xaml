<UserControl x:Class="MVTC.App.Views.MissionControlLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="BlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- STATUS STRIP -->
        <Border Grid.Row="0" Background="{DynamicResource SubHeaderBgBrush}" BorderBrush="{DynamicResource SubHeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="24,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderBrand" Text="MVTC Operator Console" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <!-- health pill -->
                <Border Background="#0F1F18" BorderBrush="#1D3A26" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#22C55E" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="All systems operational" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Rev 1.7.0"      Margin="20,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Fleet 127.0.0.1" Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SessionText" Text="Session: SESS_--------" Margin="16,0,0,0" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- METRIC TILES -->
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Points -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,5,0">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="#22C55E"/>
                    <StackPanel Margin="18,14,16,14">
                        <TextBlock Text="POINTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="PointsValue" Text="0" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PointsSub"   Text="of 4,680 total" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress -->
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="5,0,5,0">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="#A78BFA"/>
                    <StackPanel Margin="18,14,16,14">
                        <TextBlock Text="PROGRESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="ProgressValue" Text="0 / 50" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="ProgressSub"   Text="challenges solved" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Open -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="5,0,5,0">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="#FBB463"/>
                    <StackPanel Margin="18,14,16,14">
                        <TextBlock Text="OPEN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="OpenValue" Text="50" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="to solve" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Role -->
            <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="5,0,0,0">
                <Grid>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="#FF4F6D"/>
                    <StackPanel Margin="18,14,16,14">
                        <TextBlock Text="ROLE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="RoleValue" Text="user" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="RoleSub"   Text="admin console locked" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- CHART + HEALTH -->
        <Grid Grid.Row="2" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="POINTS TIMELINE" Style="{StaticResource BlockTitle}"/>
                        <TextBlock x:Name="ChartSummary" Text="&#x2022; last 50 submissions" Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <Canvas Grid.Row="1" x:Name="ChartCanvas" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="start" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas"/>
                        <TextBlock x:Name="ChartLatest" Text="now" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Health card -->
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource BlockTitle}"/>
                    <StackPanel x:Name="HealthList"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
