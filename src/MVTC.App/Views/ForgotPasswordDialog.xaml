<Window x:Class="MVTC.App.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account recovery"
        Width="520" Height="400" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Reset your password" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.75" Margin="0,4,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                       Text="Enter the username whose password you want to reset. A reset token will be issued and shown here. Redeem the token on the same username to re-issue a session."/>

            <TextBlock Text="USERNAME" FontSize="10" Opacity="0.6" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="UserBox" Text="admin"
                     Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}" Padding="8" FontFamily="Consolas"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Request reset token" Click="OnRequest"
                        Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="12,6" MinWidth="180" Cursor="Hand"/>
            </StackPanel>

            <TextBlock Text="RESET TOKEN" FontSize="10" Opacity="0.6" FontWeight="SemiBold" Margin="0,16,0,4" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="TokenBox"
                     Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}" Padding="8" FontFamily="Consolas"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Redeem token" Click="OnRedeem"
                        Background="{DynamicResource BrandBgBrush}" Foreground="{DynamicResource BrandFgBrush}"
                        BorderThickness="0" Padding="14,6" MinWidth="160" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Close" Click="OnClose" Margin="10,0,0,0"
                        Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="14,6" MinWidth="90" Cursor="Hand"/>
            </StackPanel>

            <TextBlock x:Name="OutText" Margin="0,14,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
