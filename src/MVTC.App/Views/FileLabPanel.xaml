<UserControl x:Class="MVTC.App.Views.FileLabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070A0F" Foreground="#E6EDF3"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0F17"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#161B22"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#161B22"/>
            <Setter Property="RowBackground" Value="#0A0F17"/>
            <Setter Property="AlternatingRowBackground" Value="#101620"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock Text="Documents" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.65" Margin="0,4,0,20"
                       Text="Upload documents, view reports, extract vendor archives, and import saved state."/>

            <!-- UPLOAD / DRAG-DROP -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="UPLOAD"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Drag a file onto the drop zone, or click Browse. Files land in your personal documents folder and show up in the library below."/>
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="#0A0F17"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="22"
                            MinHeight="130"
                            Drop="OnDrop"
                            DragEnter="OnDragEnter"
                            DragLeave="OnDragLeave"
                            DragOver="OnDragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       Text="&#xE898;" FontSize="26"
                                       HorizontalAlignment="Center" Foreground="#58A6FF"/>
                            <TextBlock Text="Drop files here to upload" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DropHint" Text="or" Opacity="0.6" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <Button Content="Browse…" Click="OnBrowse" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource H2}" Text="LIBRARY" Margin="0,16,0,6"/>
                    <DataGrid x:Name="LibraryGrid" MinHeight="140" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filename" Binding="{Binding Name}"    Width="*"/>
                            <DataGridTextColumn Header="Size (B)" Binding="{Binding Length}"  Width="90"/>
                            <DataGridTextColumn Header="Resolved to" Binding="{Binding Path}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="UploadStatus" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ARCHIVES -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="ARCHIVE EXTRACTOR"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Unzip a vendor-supplied archive into the extraction folder."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ZipPath"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Extract" Click="OnExtractZip"/>
                    </Grid>
                    <TextBlock x:Name="ZipOut" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- REPORTS -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="REPORTS"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="View a report from the reports folder. Enter a report name (e.g. quarterly.txt)."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ReportPath" Text="quarterly.txt"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Open report" Click="OnReadReport"/>
                    </Grid>
                    <TextBlock x:Name="ReportOut" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- HELP -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="HELP / KNOWLEDGE BASE"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Open the bundled help file, or point at a custom .chm when IT ships you a one-off."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="HelpPath"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Open help" Click="OnOpenHelp"/>
                    </Grid>
                    <TextBlock x:Name="HelpOut" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- STATE IMPORT -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="IMPORT SAVED STATE"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Restore vault manager state from a snapshot (.json) exported by another workstation."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="StatePath"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Import state" Click="OnImportState"/>
                    </Grid>
                    <TextBlock x:Name="StateOut" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- XML -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="XML CONFIG IMPORT"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Load an XML configuration file. External entities are resolved so you can split your config across files."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="XmlPath"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Load XML" Click="OnImportXml"/>
                    </Grid>
                    <TextBlock x:Name="XmlOut" Margin="0,8,0,0" FontFamily="Consolas" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
