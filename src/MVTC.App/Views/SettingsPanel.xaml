<UserControl x:Class="MVTC.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070A0F" Foreground="#E6EDF3"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,16" Opacity="0.75"
                       Text="Post-install helpers, service control, dependency checks, and runtime configuration."/>

            <!-- STATUS -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Status"/>
                    <TextBlock x:Name="StatusText" FontFamily="Consolas" Opacity="0.9"/>
                    <Button Content="Refresh status" Margin="0,8,0,0" Click="OnRefresh"/>
                </StackPanel>
            </Border>

            <!-- CONFIGURATION -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Configuration"/>
                    <TextBlock Opacity="0.65" FontSize="12"
                               Text="Point the backend endpoints at any host - swap localhost for your own test server, a staging URL, or a Burp proxy on your network. All values are read from and written to config.xml."/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="BACKEND API URL"/>
                    <TextBox x:Name="ApiUrlBox"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="UPDATE MANIFEST URL"/>
                    <TextBox x:Name="UpdateUrlBox"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT PING / TRACE TARGET (IP, hostname, or URL)"/>
                    <TextBox x:Name="PingTargetBox" Text="127.0.0.1"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="HTTP INTERCEPTION PROXY (optional) - e.g. http://127.0.0.1:8080 for Burp"/>
                    <TextBox x:Name="ProxyBox"/>

                    <CheckBox x:Name="AllowInsecureBox" Content="Trust all server certificates (HTTPS)" Foreground="#E6EDF3" Margin="0,14,0,0"/>
                    <CheckBox x:Name="PreferHttpsBox" Content="Prefer HTTPS over HTTP where possible" Foreground="#E6EDF3" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Auto-detect from current services" Click="OnAutoDetect" MinWidth="260"/>
                        <Button Content="Apply + save"            Margin="8,0,0,0" Click="OnSaveConfig" Background="#3FB950" MinWidth="140"/>
                        <Button Content="Open config.xml"         Margin="8,0,0,0" Background="#30363D" Click="OnOpenConfigXml" MinWidth="150"/>
                    </StackPanel>
                    <TextBlock x:Name="ConfigStatus" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12" Opacity="0.9"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEBUG TELEMETRY ENDPOINT  (POSTed with session detail - set to a listener you control)"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TelemetryUrlBox" Text="http://127.0.0.1:9999/"/>
                        <Button  Grid.Column="1" Margin="8,0,0,0" Content="Send diagnostic report" Click="OnSendTelemetry" Background="#B35400" MinWidth="200"/>
                    </Grid>
                    <TextBlock x:Name="TelemetryOut" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" Opacity="0.9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- SERVICE / POST-INSTALL -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Post-installation (requires admin)"/>
                    <TextBlock Margin="0,0,0,6" Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                               Text="Apply the lab preconditions after an MSI install. Each triggers Windows UAC."/>
                    <Button Content="Finalize install (unquote service path)" Click="OnFinalizeUnquotePath"/>
                    <Button Content="Start MVTCVaultSvc"     Margin="0,8,0,0" Click="OnStartService"/>
                    <Button Content="Stop MVTCVaultSvc"      Margin="0,8,0,0" Background="#30363D" Click="OnStopService"/>
                </StackPanel>
            </Border>

            <!-- DEPENDENCIES -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dependencies"/>
                    <TextBlock x:Name="DotNetText" FontFamily="Consolas" Opacity="0.9"/>
                    <Button Content="Download .NET 10 Desktop Runtime" Margin="0,8,0,0" Click="OnDownloadDotNet"/>
                </StackPanel>
            </Border>

            <!-- LAB PATHS -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Lab paths"/>
                    <Button Content="Open install directory"       Click="OnOpenInstallDir"/>
                    <Button Content="Open per-user data (APPDATA)" Margin="0,8,0,0" Click="OnOpenAppData"/>
                    <Button Content="Open audit.log"               Margin="0,8,0,0" Click="OnOpenAuditLog"/>
                    <Button Content="Open config.xml"              Margin="0,8,0,0" Click="OnOpenConfigXml"/>
                </StackPanel>
            </Border>

            <!-- RESET -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Reset"/>
                    <Button Content="Soft reset (clear progress only)" Click="OnSoftReset"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="OutText" Margin="0,14,0,0" FontFamily="Consolas" TextWrapping="Wrap" Opacity="0.9"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
