<UserControl x:Class="MVTC.App.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070A0F" Foreground="#E6EDF3"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
        </Style>
        <Style x:Key="ChallengeTag" TargetType="Border">
            <Setter Property="Background" Value="#1A2B14"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChallengeTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#3FB950"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="SubHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="OutBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Account" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,16" Opacity="0.75"
                       Text="Account recovery, profile, API keys, session restore. Features here map to realistic account-management surfaces found in enterprise desktop clients."/>

            <!-- #46 Password recovery -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Account recovery"/>
                        <Border Style="{StaticResource ChallengeTag}">
                            <TextBlock Style="{StaticResource ChallengeTagText}" Text="#46 CWE-640"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHint}"
                               Text="Simulated reset. In production the token would be stored server-side, random, single-use, and short-lived. Here the token is computed client-side and shown to you - exactly the mistake."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="USERNAME TO RESET"/>
                    <TextBox x:Name="ResetUserBox" Text="admin"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Request reset token" Click="OnRequestReset" Background="#30363D"/>
                        <TextBox x:Name="ResetTokenBox" Width="320" Margin="10,0,0,0"/>
                        <Button Content="Redeem token" Margin="10,0,0,0" Click="OnRedeemReset" Background="#3FB950" MinWidth="140"/>
                    </StackPanel>
                    <TextBlock x:Name="ResetOut" Style="{StaticResource OutBlock}"/>
                </StackPanel>
            </Border>

            <!-- #47 Lookup asset by ID -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Lookup asset by ID"/>
                        <Border Style="{StaticResource ChallengeTag}">
                            <TextBlock Style="{StaticResource ChallengeTagText}" Text="#47 CWE-639"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHint}"
                               Text="Fetch any asset in the vault by its numeric id. The server does not verify that the current user owns the asset - any id returns what is stored under it."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ASSET ID"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AssetIdBox" Width="200" Text="1"/>
                        <Button Content="Look up" Margin="10,0,0,0" Click="OnLookupAsset" MinWidth="120"/>
                    </StackPanel>
                    <TextBlock x:Name="AssetOut" Style="{StaticResource OutBlock}"/>
                </StackPanel>
            </Border>

            <!-- #48 Profile update (mass assignment) -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Update profile (raw JSON)"/>
                        <Border Style="{StaticResource ChallengeTag}">
                            <TextBlock Style="{StaticResource ChallengeTagText}" Text="#48 CWE-915"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHint}"
                               Text="Advanced editor: paste the raw JSON body as it will be POSTed. The server deserializes it directly into the user record. The visible form only shows display name and email - but what the API will accept is a different story."/>
                    <TextBox x:Name="ProfileJsonBox" Height="120" AcceptsReturn="True" TextWrapping="NoWrap"
                             Text="{}{&#xA;  &quot;displayName&quot;: &quot;m14r41&quot;,&#xA;  &quot;email&quot;: &quot;m14r41@mvtc.local&quot;&#xA;}"/>
                    <Button Content="PUT /api/profile" Margin="0,10,0,0" Click="OnUpdateProfile" Background="#B35400"/>
                    <TextBlock x:Name="ProfileOut" Style="{StaticResource OutBlock}"/>
                </StackPanel>
            </Border>

            <!-- #49 Weak PRNG API key -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Personal API keys"/>
                        <Border Style="{StaticResource ChallengeTag}">
                            <TextBlock Style="{StaticResource ChallengeTagText}" Text="#49 CWE-338"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHint}"
                               Text="Issue a new personal API key. Keys look random. The 'admin API key' was issued the same way during install, so if you can reproduce the generator you can reproduce the key."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Generate new key" Click="OnGenKey"/>
                        <TextBox x:Name="VerifyKeyBox" Width="340" Margin="10,0,0,0"/>
                        <Button Content="Verify as admin key" Margin="10,0,0,0" Background="#3FB950" Click="OnVerifyKey" MinWidth="180"/>
                    </StackPanel>
                    <TextBlock x:Name="KeyOut" Style="{StaticResource OutBlock}"/>
                </StackPanel>
            </Border>

            <!-- #50 JWT session restore -->
            <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Restore session (JWT)"/>
                        <Border Style="{StaticResource ChallengeTag}">
                            <TextBlock Style="{StaticResource ChallengeTagText}" Text="#50 CWE-321"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHint}"
                               Text="Paste a session JWT. The client verifies HS256 against a secret and, if valid, restores the session under the token's sub claim. The secret is baked into the binary."/>
                    <TextBox x:Name="JwtBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.PASTE_SIGNATURE_HERE"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Restore session" Click="OnRestoreJwt" Background="#B35400" MinWidth="200"/>
                        <Button Content="Mint demo JWT (sub=m14r41)" Click="OnMintDemoJwt" Margin="10,0,0,0" Background="#30363D" MinWidth="240"/>
                    </StackPanel>
                    <TextBlock x:Name="JwtOut" Style="{StaticResource OutBlock}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
