<UserControl x:Class="MVTC.App.Views.PrivescLabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070A0F" Foreground="#E6EDF3"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0F17"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#161B22"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#161B22"/>
            <Setter Property="RowBackground" Value="#0A0F17"/>
            <Setter Property="AlternatingRowBackground" Value="#101620"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Admin console" FontSize="22" FontWeight="SemiBold"/>
                <Border Background="#121D33" CornerRadius="4" Padding="8,2" Margin="12,8,0,0">
                    <TextBlock x:Name="RoleBadge" Text="role: user" FontSize="11" FontFamily="Consolas" Foreground="#58A6FF"/>
                </Border>
            </StackPanel>
            <TextBlock Opacity="0.65" Margin="0,4,0,12"
                       Text="Operational endpoints for the vault manager fleet. Some panels are restricted to the admin role."/>

            <!-- Role gate banner (visible for non-admin sessions) -->
            <Border x:Name="RoleGateBanner" Background="#2D1A08" BorderBrush="#F0883E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Text="&#xE785;" FontSize="18" Foreground="#F0883E" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Admin role required" FontWeight="SemiBold" Foreground="#F0883E"/>
                        <TextBlock Opacity="0.9" FontSize="12" TextWrapping="Wrap"
                                   Text="Your current session is 'user'. Read-only features below will still return something, but any admin-gated action (sealed secrets, integrity sign-off, user export) returns an 'access denied' and your attempt is audited. Lab exits that unlock admin: #10 HKCU role flip, #11 client-side authz bypass."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- USERS DIRECTORY -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H2}" Text="USERS DIRECTORY"/>
                        <TextBlock Style="{StaticResource H2}" Text="  ·  admin-only" Opacity="0.3"/>
                    </StackPanel>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Fleet directory with roles and provisioning keys. Lives behind the admin role check."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Load users"             Click="OnLoadUsers"/>
                        <Button Content="Re-read role (HKCU)"    Margin="8,0,0,0" Background="#30363D" Click="OnReloadRole"/>
                    </StackPanel>
                    <TextBlock x:Name="UsersError" Margin="0,8,0,0" Foreground="#F85149" FontSize="12"/>
                    <DataGrid x:Name="UsersGrid" Margin="0,10,0,0" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"         Binding="{Binding Id}"       Width="60"/>
                            <DataGridTextColumn Header="Username"   Binding="{Binding Username}" Width="140"/>
                            <DataGridTextColumn Header="Role"       Binding="{Binding Role}"     Width="90"/>
                            <DataGridTextColumn Header="Email"      Binding="{Binding Email}"    Width="220"/>
                            <DataGridTextColumn Header="API key"    Binding="{Binding ApiKey}"   Width="*"/>
                            <DataGridTextColumn Header="Last login" Binding="{Binding LastLogin}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- SEALED SECRETS -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="SEALED VAULT"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Sealed secrets released to callers that have confirmed advanced privilege. Flag unlocked only on a successful elevation."/>
                    <CheckBox x:Name="ExtraPriv" Content="Advanced privilege confirmed" Foreground="#E6EDF3" IsEnabled="False"/>
                    <Button Content="Open sealed vault" Margin="0,10,0,0" Click="OnOpenSealedVault"/>
                    <DataGrid x:Name="SealedGrid" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  Width="220"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Note"  Binding="{Binding Note}"  Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- INTEGRITY REPORT -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="SIGNED INTEGRITY REPORT"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Diagnostic hash chain the client submits to the backend to prove it hasn't been tampered with."/>
                    <Button Content="Generate integrity report" Click="OnVerifyIntegrity" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="VerifyOut" Margin="0,10,0,0" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- HELPER DLL -->
            <Border Background="#0D1117" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="HELPER MODULE"/>
                    <TextBlock Opacity="0.6" FontSize="12" Margin="0,2,0,10"
                               Text="Dynamically load an optional helper module. The vault manager uses this surface to extend capability per deployment."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="HelperDll" Text="AppHelper.dll"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Load module" Click="OnLoadHelper"/>
                    </Grid>
                    <TextBlock x:Name="HelperOut" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
