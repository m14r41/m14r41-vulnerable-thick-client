<Window x:Class="MVTC.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MVTC Vault Manager"
        Height="700" Width="1140"
        MinHeight="520" MinWidth="820"
        Background="Transparent"
        Foreground="#E8EAF0"
        FontFamily="Segoe UI"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="pack://application:,,,/Resources/mvtc.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MacDot" TargetType="Grid">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Pink/indigo gradient primary CTA matching the hero -->
        <LinearGradientBrush x:Key="HeroCta" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF4F8B"/>
            <GradientStop Offset="1" Color="#8B5CF6"/>
        </LinearGradientBrush>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource HeroCta}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="FormInput">
            <Setter Property="Background" Value="#1E2029"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#2C2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF9BB8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox" x:Key="FormPwd">
            <Setter Property="Background" Value="#1E2029"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#2C2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF9BB8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA0AE"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="#0E0F13" BorderBrush="#22262E" BorderThickness="1" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="Black" Opacity="0.55"/>
        </Border.Effect>

        <Border CornerRadius="10" ClipToBounds="True" Background="#0E0F13">
            <DockPanel LastChildFill="True">

                <!-- TITLE BAR with purple-pink hint -->
                <Border DockPanel.Dock="Top" Height="36" BorderThickness="0,0,0,1" BorderBrush="#2C2F3A">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0"   Color="#1A0E2A"/>
                            <GradientStop Offset="0.5" Color="#141825"/>
                            <GradientStop Offset="1"   Color="#0E1831"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Style="{StaticResource MacDot}" MouseLeftButtonUp="OnDotClose">
                                <Ellipse Fill="#FF5F57"/>
                                <TextBlock Text="&#x2715;" FontSize="9" FontWeight="Bold" Foreground="#5A0C06" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Style="{StaticResource MacDot}" MouseLeftButtonUp="OnDotMin">
                                <Ellipse Fill="#FEBC2E"/>
                                <TextBlock Text="&#x2212;" FontSize="12" FontWeight="Bold" Foreground="#5C3200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Grid>
                            <Grid Style="{StaticResource MacDot}" MouseLeftButtonUp="OnDotMax">
                                <Ellipse Fill="#28C840"/>
                                <TextBlock Text="&#x2795;" FontSize="7" FontWeight="Bold" Foreground="#064E13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="MVTC Vault Manager" FontSize="12" Foreground="#C0C3D0" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Button x:Name="ThemeBtn" Click="OnCycleTheme" Cursor="Hand" ToolTip="Change color theme"
                                    Background="Transparent" BorderThickness="1" BorderBrush="#3A2F55"
                                    Padding="7,3" Margin="0,0,10,0">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Foreground="#C0C3D0"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN TWO-COLUMN LAYOUT -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: mesh gradient hero -->
                    <Grid Grid.Column="0" ClipToBounds="True">
                        <!-- Base dark -->
                        <Rectangle Fill="#0E0F13"/>
                        <!-- Three overlapping radials build the mesh -->
                        <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-140,0,0" Opacity="0.9">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Offset="0"   Color="#FF4F8B"/>
                                    <GradientStop Offset="0.55" Color="#AA366B"/>
                                    <GradientStop Offset="1"   Color="#00FF4F8B"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="820" Height="700" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-150,0" Opacity="0.9">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Offset="0"   Color="#4F7BFF"/>
                                    <GradientStop Offset="0.55" Color="#374DAA"/>
                                    <GradientStop Offset="1"   Color="#004F7BFF"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="900" Height="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-180" Opacity="0.85">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Offset="0"   Color="#8B5CF6"/>
                                    <GradientStop Offset="0.55" Color="#5B3DAA"/>
                                    <GradientStop Offset="1"   Color="#008B5CF6"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Center vignette -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Offset="0.35" Color="#000E0F13"/>
                                    <GradientStop Offset="1"    Color="#660E0F13"/>
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Dot-grid decoration in bottom-right corner, fades toward center -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" IsHitTestVisible="False" Width="220" Height="220">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#30FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="7,7" RadiusX="1" RadiusY="1"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush GradientOrigin="1,1" Center="1,1" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Offset="0.2" Color="Black"/>
                                        <GradientStop Offset="0.9" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <!-- Content on top -->
                        <Grid Margin="56,40,56,32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Brand monogram -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="9" BorderBrush="#30FFFFFF" BorderThickness="1" Background="#22FFFFFF">
                                    <TextBlock Text="M" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <TextBlock Text="MVTC" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Big tagline + full-name credit beneath -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="Secure the vault."
                                           FontSize="54" FontWeight="Bold" LineHeight="60" Foreground="White"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Breach the client."
                                           FontSize="54" FontWeight="Bold" LineHeight="60" Foreground="#FFE6F0"
                                           FontFamily="Segoe UI"/>

                                <!-- Full product name beneath tagline (placement #6) -->
                                <StackPanel Margin="0,26,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="18" Height="1" Fill="White" Opacity="0.4" VerticalAlignment="Center"/>
                                        <TextBlock Text="  The product" Margin="4,0,0,0" FontFamily="Consolas" FontSize="11" Opacity="0.7" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="M14R41 Vulnerable Thick Client" FontSize="16" FontWeight="Bold" Foreground="#FFE6F0"/>
                                        <TextBlock Text="   v1.7" Margin="4,2,0,0" FontFamily="Consolas" FontSize="12" Opacity="0.6" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Row 2 kept empty for layout balance; no footer stats -->
                            <StackPanel Grid.Row="2"/>
                        </Grid>
                    </Grid>

                    <!-- RIGHT: dark form card -->
                    <Border Grid.Column="1" Background="#14161C" BorderBrush="#22262E" BorderThickness="1,0,0,0" CornerRadius="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,56,40,36" VerticalAlignment="Center">

                                <TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold" Foreground="#F0F3F7"/>
                                <TextBlock Text="Sign in to your workspace" Margin="0,4,0,28" Foreground="#9AA0AE"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL OR USERNAME"/>
                                <TextBox Style="{StaticResource FormInput}" x:Name="UsernameBox" Text="m14r41"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="PASSWORD" Margin="0,16,0,6"/>
                                <PasswordBox Style="{StaticResource FormPwd}" x:Name="PasswordBox"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="RememberBox" Content="Remember me" Foreground="#E8EAF0" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Button   Grid.Column="1" Content="Forgot password?" Click="OnForgotPassword"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="#FF9BB8" FontSize="12"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Padding="4,2"/>
                                </Grid>

                                <Button Style="{StaticResource PrimaryBtn}"
                                        Content="Sign in"
                                        Margin="0,20,0,0"
                                        Click="OnSignIn"
                                        IsDefault="True"
                                        HorizontalAlignment="Stretch"/>

                                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#F85149" FontSize="12"/>

                                <!-- Collapsible Hacker Notes -->
                                <Border Margin="0,28,0,0" Background="#0F1016" CornerRadius="8" BorderBrush="#2A2435" BorderThickness="1">
                                    <StackPanel>
                                        <Button x:Name="NotesToggle" Click="OnToggleNotes" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Padding="12,10"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="HACKER NOTES" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#9AA0AE" VerticalAlignment="Center">
                                                    <TextBlock.LayoutTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                                <TextBlock x:Name="NotesCaret" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <StackPanel x:Name="NotesBody" Visibility="Collapsed" Margin="12,0,12,14">
                                            <!-- Default creds row -->
                                            <Border Background="#1E2029" BorderBrush="#3A2F55" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="default" FontFamily="Consolas" FontSize="10" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  m14r41"  FontFamily="Consolas" FontSize="12" Foreground="#F0F3F7" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  /  "     FontFamily="Consolas" FontSize="12" Foreground="#9AA0AE" VerticalAlignment="Center"/>
                                                    <TextBlock Text="test@123"  FontFamily="Consolas" FontSize="12" Foreground="#FFBED6" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Margin="0,12,0,10" FontSize="11" Opacity="0.9" TextWrapping="Wrap" Foreground="#9AA0AE"
                                                       Text="Three more accounts exist. Discover them."/>

                                            <!-- Role chips -->
                                            <WrapPanel>
                                                <Border Background="#1E2029" BorderBrush="#3A2F55" BorderThickness="1" CornerRadius="999" Padding="10,3" Margin="0,0,6,6">
                                                    <TextBlock Text="admin"      FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#FFBED6"/>
                                                </Border>
                                                <Border Background="#1E2029" BorderBrush="#3A2F55" BorderThickness="1" CornerRadius="999" Padding="10,3" Margin="0,0,6,6">
                                                    <TextBlock Text="auditor"    FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#FFBED6"/>
                                                </Border>
                                                <Border Background="#1E2029" BorderBrush="#3A2F55" BorderThickness="1" CornerRadius="999" Padding="10,3" Margin="0,0,6,6">
                                                    <TextBlock Text="svc_backup" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#FFBED6"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
